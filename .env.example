# Copie este arquivo para ".env" (na mesma pasta do docker-compose.yml) e preencha.

# Chave de API WEB do Firebase (não é segredo; fica em: Console do Firebase >
# Configurações do projeto > Geral > "Chave de API da Web")
FIREBASE_WEB_API_KEY=

# 1 = modo debug do Flask (só para desenvolvimento local)
FLASK_DEBUG=1
